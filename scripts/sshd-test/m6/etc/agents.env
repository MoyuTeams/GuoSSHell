# M6：三个 coding agent 指向容器内的假上游（aimock，127.0.0.1:4010）的环境变量。
# m6-agent / m6-tui 显式读取；交互式登录 shell 经 /etc/profile.d/m6.sh 导出。

# Claude Code：用 token 认证（没有 API key 确认与连通性检查），关掉非必要流量后完全离线。
ANTHROPIC_BASE_URL=http://127.0.0.1:4010
ANTHROPIC_AUTH_TOKEN=m6
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1

# Codex：~/.codex/config.toml 里的 provider 从这个变量取 key。
M6_API_KEY=m6

# opencode：内置的模型目录快照够用；不自动更新、不分享。
OPENCODE_DISABLE_MODELS_FETCH=1
OPENCODE_DISABLE_AUTOUPDATE=1
OPENCODE_DISABLE_SHARE=1

# nvtop 的假 GPU（NVIDIA mocknvml，两块会动的 L40S）。
MOCK_NVML_CONFIG=/etc/m6/nvml.yaml
